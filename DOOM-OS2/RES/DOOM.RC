/* Resources for DOOM/2.
 *
 * There is exactly one, and it is optional: the window icon.
 *
 * DOOM.OS2 is NOT in the source tree.  It is generated into BUILD\ by
 * MKOS2.CMD, which runs TOOLS\ICO2OS2.C over RES\DOOM.ICO to rewrite the
 * Windows icon in the format PM reads.
 *
 * That conversion cannot be skipped by pointing the statement below straight
 * at the .ICO.  wrc accepts a Windows icon for an OS/2 target, exits 0, and
 * embeds it verbatim as an RT_POINTER; PM then cannot load it, and you get no
 * icon and no error anywhere to say why.  What PM wants is a bitmap array of
 * two version-1 'CI' bitmaps -- mono mask first, then colour -- which is what
 * ICO2OS2 emits.  A genuine OS/2 icon (saved by ICONEDIT, or lifted from
 * \OS2\BITMAP) would also do; it would just have to be named DOOM.OS2 and
 * dropped into BUILD\ by hand.
 *
 * This whole file is skipped by MKOS2.CMD when RES\DOOM.ICO is not present,
 * and I_VIDEO.C loads the icon with WinLoadPointer rather than asking for it
 * through FCF_ICON, so a missing or malformed icon costs nothing worse than
 * the default program icon.
 */

#define ID_DOOM_ICON	1

ICON ID_DOOM_ICON	"DOOM.OS2"
